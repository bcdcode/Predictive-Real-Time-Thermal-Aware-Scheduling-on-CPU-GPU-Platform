#!/usr/bin/env python3
import csv
import glob
import os
import sys
from datetime import datetime

MAX_AGE_SECONDS = 5
ENTER_THRESHOLD = 4
EXIT_THRESHOLD = 2
STATE_FILE = "rt_tas_shadow_state.txt"

files = sorted(
    glob.glob("thermal_predictor_shadow_*.csv"),
    key=os.path.getmtime,
    reverse=True,
)

if not files:
    print("STATUS=NO_LOG")
    sys.exit(0)

path = files[0]

try:
    with open(path, newline="") as f:
        rows = list(csv.DictReader(f))

    if not rows:
        print("STATUS=EMPTY_LOG")
        sys.exit(0)

    row = rows[-1]
    sample_time = datetime.fromisoformat(
        row["timestamp"]
    ).astimezone()
    now = datetime.now().astimezone()
    age = (now - sample_time).total_seconds()

    print(f"FILE={path}")
    print(f"SAMPLE_TIMESTAMP={row['timestamp']}")
    print(f"AGE_SECONDS={age:.1f}")

    if age < -2:
        print("STATUS=CLOCK_MISMATCH")
        sys.exit(0)

    if age > MAX_AGE_SECONDS:
        print("STATUS=STALE")
        sys.exit(0)

    score = int(row["dynamic_score"])
    level = row["prediction_level"]
    phase = row["phase"]

    # Read the previous shadow state.
    state = "KEEP_TWFD"
    try:
        with open(STATE_FILE) as f:
            saved = f.read().strip()
        if saved in ("KEEP_TWFD", "SHADOW_REVIEW"):
            state = saved
    except FileNotFoundError:
        pass

    # Hysteresis: separate enter and exit thresholds.
    if score >= ENTER_THRESHOLD:
        state = "SHADOW_REVIEW"
    elif score <= EXIT_THRESHOLD:
        state = "KEEP_TWFD"
    # If score == 3, retain the previous state.

    # Persist the state for the next invocation.
    temp_state = STATE_FILE + ".tmp"
    with open(temp_state, "w") as f:
        f.write(state + "\n")
    os.replace(temp_state, STATE_FILE)

    print("STATUS=FRESH")
    print(f"SCORE={score}")
    print(f"LEVEL={level}")
    print(f"PHASE={phase}")
    print(f"ENTER_THRESHOLD={ENTER_THRESHOLD}")
    print(f"EXIT_THRESHOLD={EXIT_THRESHOLD}")
    print(f"RECOMMENDATION={state}")

except (OSError, ValueError, KeyError, csv.Error) as e:
    print("STATUS=READ_ERROR")
    print(str(e))
    sys.exit(1)
